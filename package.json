{
  "name": "pielgrzym-bot",
  "version": "0.0.8",
  "description": "Dedicated Discord bot for zbawienie.pl and zasobybiblijne.org websites",
  "main": "index.js",
  "scripts": {
    "start": "nodemon",
    "deploy:clear": "node deploy-commands.js clear",
    "deploy:guild": "node deploy-commands.js guild",
    "deploy:global": "node deploy-commands.js global",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "validate": "pnpm format:check && pnpm lint",
    "prepare": "husky"
  },
  "keywords": [
    "bot",
    "discord",
    "discord-bot",
    "discordjs"
  ],
  "author": {
    "name": "Jakub Kłało",
    "email": "jakub@klalo.pl",
    "url": "https://www.klalo.pl"
  },
  "license": "ISC",
  "packageManager": "pnpm@11.28.6",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "dependencies": {
    "bufferutil": "^4.1.0",
    "colors": "^1.4.0",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "he": "^1.2.0",
    "moment": "^2.31.0",
    "node-cron": "^4.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.4.1",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "nodemon": "^3.1.14",
    "prettier": "3.8.3"
  },
  "nodemonConfig": {
    "ignore": [
      "data/*",
      "logs/*"
    ]
  }
}
